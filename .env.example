# DriverBee Production Environment Configuration Template
# Duplicate this file to .env.local for local development.
# In production (e.g. Vercel), set these variables in the deployment dashboard.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration (Required)
# Found at: Supabase Dashboard > Project Settings > API
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# Email Delivery Service (Optional)
# Resend API Key for sending booking receipts directly to customers (https://resend.com)
# ─────────────────────────────────────────────────────────────────────────────
VITE_RESEND_API_KEY=your-resend-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Operations & Admin Settings (Optional)
# Dispatch notification email for receiving booking alerts
# ─────────────────────────────────────────────────────────────────────────────
VITE_DISPATCH_EMAIL=officialdriverbee@gmail.com

# Local development override for admin dashboard password (optional)
# VITE_ADMIN_PASSWORD=your-secure-admin-password
